# Django / CogLearning environment variables
# Copy to .env and adjust for your environment.

# Required in production (DEBUG=False). Optional in local DEBUG mode.
SECRET_KEY=change-me-to-a-long-random-string

# true/false — defaults to True for local development
DEBUG=True

# Comma-separated hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave POSTGRES_DB / DATABASE_URL unset to use SQLite (db.sqlite3).
# Set either DATABASE_URL or POSTGRES_DB to use PostgreSQL.

# DATABASE_URL=postgres://user:password@localhost:5432/coglearning

POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS (used when DEBUG=False) ---
# Comma-separated origins, e.g. https://app.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=

# --- JWT (configured in settings.py) ---
# ACCESS_TOKEN_LIFETIME = 60 minutes
# REFRESH_TOKEN_LIFETIME = 1 day
