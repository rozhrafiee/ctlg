# Django / CogLearning environment variables
# Copy to .env and adjust for your environment.

# --- Debug / secrets ---
# Local: DEBUG=True (insecure SECRET_KEY fallback is allowed).
# Production: DEBUG=False and SECRET_KEY is required.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated hosts (include testserver for Django APIClient / e2e scripts)
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Database ---
# Leave POSTGRES_DB / DATABASE_URL unset to use SQLite (db.sqlite3).
# Set either DATABASE_URL or POSTGRES_DB to use PostgreSQL.

# DATABASE_URL=postgres://user:password@localhost:5432/coglearning

POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS (used when DEBUG=False) ---
# Comma-separated origins, e.g. https://app.example.com,https://www.example.com
# When DEBUG=True, all origins are allowed.
CORS_ALLOWED_ORIGINS=

# --- Production HTTPS / cookies (applied only when DEBUG=False) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- JWT ---
# Access lifetime in minutes; refresh lifetime in days.
# ROTATE_REFRESH_TOKENS and BLACKLIST_AFTER_ROTATION are enabled.
# Logout (POST /api/accounts/logout/) blacklists the refresh token via
# rest_framework_simplejwt.token_blacklist — run migrations after install.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1
